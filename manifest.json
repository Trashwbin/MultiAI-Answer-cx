{
  "manifest_version": 3,
  "name": "MultiAI Answer",
  "description": "基于多模型 AI 投票的智能答题助手。填入任意 OpenAI 兼容 API 的 Base URL 与 API Key，自动拉取可用模型，勾选后即可发送题目。",
  "version": "2.3.0",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "author": "Trashwbin",
  "options_ui": {
    "page": "src/options/manager.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "system.display",
    "scripting"
  ],
   "host_permissions": [
     "https://*.chaoxing.com/*",
     "https://models.dev/*",
     "https://cdn.jsdelivr.net/*",
     "http://127.0.0.1:*/*",
     "http://localhost:*/*"
   ],
   "optional_host_permissions": [
     "https://*/*",
     "http://*/*"
   ],
   "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chaoxing.com/*/work*",
        "https://*.chaoxing.com/*/mooc2/work*",
        "https://*.chaoxing.com/*/exam*",
        "https://*.chaoxing.com/*/mooc2/exam*",
        "https://*.chaoxing.com/*/test*",
        "https://*.chaoxing.com/*/mooc2/test*",
        "https://*.chaoxing.com/mycourse/studentstudy*",
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "js": ["lib/html2canvas.min.js", "dist/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.chaoxing.com/*",
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ]
    }
  ]
}
